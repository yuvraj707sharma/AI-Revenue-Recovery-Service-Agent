# ==============================================================================
# RAZORPAY RECOVERY COPILOT — ENVIRONMENT CONFIGURATION
# ==============================================================================

# Application Environment
APP_ENV=development
PORT=8000
HOST=0.0.0.0

# ------------------------------------------------------------------------------
# 1. Razorpay Test-Mode API Credentials
# Get your free test API keys from Razorpay Dashboard:
# https://dashboard.razorpay.com/#/access/api-keys (Settings > API Keys > Generate Key)
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_AiRecoveryDemoKey
RAZORPAY_KEY_SECRET=AiRecoverySecretDemoVal12345
RAZORPAY_WEBHOOK_SECRET=webhook_secret_test_123

# ------------------------------------------------------------------------------
# 2. Database Configuration
# Uses lightweight asynchronous SQLite locally, or MySQL in Docker Compose
# ------------------------------------------------------------------------------
DATABASE_URL=sqlite+aiosqlite:///./recovery_copilot.db
DATABASE_URL_SYNC=sqlite:///./recovery_copilot.db

# ------------------------------------------------------------------------------
# 3. WhatsApp Provider (Mock / Cloud API)
# ------------------------------------------------------------------------------
WHATSAPP_PROVIDER=mock
MERCHANT_NAME=SaaSify Cloud Pro
